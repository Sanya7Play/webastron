generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Product {
    id          Int      @id @default(autoincrement())
    name        String
    description String?
    imgSrc      String[]
    categoryId  Int
    category    Category @relation(fields: [categoryId], references: [id])

    @@unique([name, categoryId], name: "name_categoryId")
}

model Category {
    id       Int       @id @default(autoincrement())
    name     String    @unique
    products Product[]
}
